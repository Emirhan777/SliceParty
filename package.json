{
  "name": "fruit-ninja-online",
  "version": "1.0.0",
  "private": true,
  "description": "Swing your phone like a sword and slice fruit on a big screen. Static site, no build step, no server of your own.",
  "type": "module",
  "scripts": {
    "start": "node tools/dev-server.mjs",
    "tunnel": "npx --yes cloudflared tunnel --url http://localhost:3000 --protocol http2",
    "tunnel:quic": "npx --yes cloudflared tunnel --url http://localhost:3000",
    "test": "node tools/tilt-test.mjs && node tools/net-test.mjs",
    "test:tilt": "node tools/tilt-test.mjs",
    "test:net": "node tools/net-test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
